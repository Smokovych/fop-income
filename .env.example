# Скопіюйте цей файл у .env і задайте свої значення: cp .env.example .env

# Користувачі реєструються в програмі (email + пароль). Реєстрація: open (будь-хто) або invite (лише за запрошенням)
REGISTRATION=open
# Хто отримає дані, збережені до появи облікових записів (необов'язково: інакше — той, хто додасть ключ з тим самим РНОКПП)
LEGACY_OWNER_EMAIL=
# Секрет для підпису cookie входу. Необов'язково: якщо порожній, сервер створить його сам
# і збереже в базі. Задати свій: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# 1 — завжди ставити Secure на cookie. За HTTPS-проксі (Railway тощо) це визначається автоматично.
COOKIE_SECURE=0
# Публічна адреса (потрібна для вебхука Monobank), напр. https://fop.example.com
PUBLIC_URL=

PORT=8080
# Як часто тягнути виписки, хвилини
SYNC_INTERVAL_MIN=60
# Скільки днів назад перечитувати при кожній синхронізації
RESYNC_OVERLAP_DAYS=3
